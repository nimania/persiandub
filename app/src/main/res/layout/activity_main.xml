<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PersianDub — دوبله زنده"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صدای دستگاه را زنده به فارسی دوبله می‌کند."
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="کلید Gemini API"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AIza..."
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:inputType="textPassword"
            android:backgroundTint="@color/muted"
            android:paddingVertical="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="زبان مقصد"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:paddingTop="18dp"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="منبع صدا"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:paddingTop="18dp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbInternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textColor="@color/text"
                android:text="صدای داخلی دستگاه (کیفیت بالا)" />

            <RadioButton
                android:id="@+id/rbMic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="میکروفون (همه‌جا کار می‌کند، با هدفون)" />
        </RadioGroup>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="شروع دوبله"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/teal" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:text="" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:text="نکته: صدای اصلی هم‌زمان پخش می‌شود؛ برای شنیدن بهتر، صدای ویدئو را کم کنید. در حالت میکروفون حتماً از هدفون استفاده کنید تا اکو نشود." />
    </LinearLayout>
</ScrollView>
